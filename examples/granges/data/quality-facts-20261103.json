  "notes": [
    {
      "id": "sbc-treatment",
      "text": "Employee-paid warrants, employer net contributions, restricted share units and synthetic cash-settled programs require separate treatment. No scalar IFRS SBC expense or cash-flow addback has been established from this note; the disclosed LTI remuneration total is not substituted for one.",
      "evidence": {
        "report_id": "granges-annual-2025",
        "page": 143,
        "quote": "Since participants themselves pay the premium, the company does not recognize any cost for the fair value of the instruments; the expense relates solely to the net contribution.",
        "sha256": "92ce24c6cac97ed9fb5957456d75900484b01196c117f4e28235f9816073eebd",
        "prepared_sha256": "4fe59fd7bac9c1730db5abdfc42d853436044e941e94d7e32787595c1afcff69",
        "source_pointer": "/142/text",
        "original_page_visually_checked": true,
        "publication_date": "2026-03-17"
      }
    },
    {
      "id": "lease-principal-gap",
      "text": "Total lease payments and accrued lease interest do not independently establish the cash principal paid outside CFO. No principal is manufactured by subtracting expense from total payments.",
      "evidence": {
        "report_id": "granges-annual-2025",
        "page": 151,
        "quote": "Lease payments - - - - -82",
